# Puma orchestrator — environment config (B.t6 full surface)
# Copy to .env and fill in real values. Never commit .env.
#
# Every key here is validated by src/config/schema.ts at startup. Missing
# required keys (ANTHROPIC_API_KEY) or invalid values (e.g. PORT=abc) cause a
# clean process.exit(1) with a readable Zod error — see src/config/load.ts.

# ---------------------------------------------------------------------------
# Required secret
# ---------------------------------------------------------------------------

# The Anthropic API key powering the orchestrator's Claude model.
# B.t1 validates presence at startup; B.t5+ actually call the model.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Orchestrator agent — conversational model (decision B.5: per-agent model)
# ---------------------------------------------------------------------------

# Default is pinned in src/config/schema.ts (DEFAULT_ORCHESTRATOR_MODEL).
# Override here to test other Claude tiers without a code change.
# ORCHESTRATOR_MODEL=claude-sonnet-4-6

# Sampling temperature for the orchestrator. Range 0..2. Default: 0.7.
# ORCHESTRATOR_TEMPERATURE=0.7

# Max output tokens per orchestrator turn. Default: 8192 (raised from 2048 so
# native thinking has output headroom — RL.5).
# ORCHESTRATOR_MAX_TOKENS=8192

# Native thinking (RL.2): gates the Anthropic `thinking` request param. Default
# ON — the reasoning-leak fix (model reasons in the stripped thinking channel
# instead of narrating in visible text). Set false as a latency escape hatch;
# when off, a "work silently" belt is injected into the system prompt instead.
# ORCHESTRATOR_THINKING_ENABLED=true

# Thinking-depth <-> latency/cost lever (RL.4). One of: low | medium | high | max.
# Server-side only (NOT a UI control). Applied when thinking is on and the model
# supports effort (Sonnet 4.6+, Opus 4.6+, Fable). Unset -> model default (high).
# ORCHESTRATOR_EFFORT=medium

# Deprecated B.t1 alias for ORCHESTRATOR_MODEL. Still honoured for backward
# compat: if set and ORCHESTRATOR_MODEL is unset, PRIMARY_MODEL is used.
# Prefer ORCHESTRATOR_MODEL in new configs.
# PRIMARY_MODEL=claude-sonnet-4-5-20250929

# ---------------------------------------------------------------------------
# Functional classifier — lightweight internal agent (B.t7 consumes)
# ---------------------------------------------------------------------------

# Default is pinned in src/config/schema.ts (DEFAULT_CLASSIFIER_MODEL).
# FUNCTIONAL_CLASSIFIER_MODEL=claude-haiku-4-5-20250929

# Low temperature — classification wants deterministic labels. Default: 0.2.
# FUNCTIONAL_CLASSIFIER_TEMPERATURE=0.2

# ---------------------------------------------------------------------------
# Content paths (relative to product/orchestrator/, resolved at startup)
# ---------------------------------------------------------------------------

# Directory containing the system-prompt fragments. The loader concatenates
# every file matching `^\d{2}_[a-z0-9-]+\.md$` in lexicographic order
# (separated by `\n\n---\n\n`) to produce the agent's instruction. See
# decision G.11 in planning/decisions.md and planning/03-exec-agent-runtime-t1a.md.
# Default: ../cms/prompts/system
# SYSTEM_PROMPT_DIR=../cms/prompts/system

# Base directory for ADK-native skill loading (B.t9 consumes via
# loadAllSkillsInDir). Each skill is a sub-directory containing SKILL.md.
# Default: ../cms/prompts/skills
# SKILLS_DIR=../cms/prompts/skills

# Directory holding one folder per tool with a `description.md` inside —
# the authoritative tool-description copy Sonnet reads (per G.11). Loaded
# at boot via loadAllToolDescriptions (re-exported from @swoop/connector).
# Boot fails fast if any of the eight tools is missing or empty.
# Default: ../cms/prompts/tools
# TOOLS_PROMPT_DIR=../cms/prompts/tools

# ---------------------------------------------------------------------------
# Session (B.t2 consumes; values: in-memory | adk-native | vertex-ai | firestore)
# ---------------------------------------------------------------------------

# Session-store backend. in-memory is the Phase 1 default; vertex-ai and
# firestore are stubs (post-M4). Default: in-memory.
# SESSION_BACKEND=in-memory

# Idle-to-archive TTL for the in-memory sweeper, in hours. Default: 24.
# SESSION_TTL_IDLE_HOURS=24

# Archive retention before deletion, in days. Default: 7.
# SESSION_TTL_ARCHIVE_DAYS=7

# ---------------------------------------------------------------------------
# Observability sink (F-c — planning/03-exec-observability-c.md)
# ---------------------------------------------------------------------------
#
# Where emitted events land (registered via setEventSink at boot):
#   stdout         one JSON line per event (default; dev).
#   postgres       durable INSERT into event_log (migration 020; single store
#                  per C.18). Requires ORCHESTRATOR_DATABASE_URL (below). Works
#                  on the demo Mini + any pre-GCP host; SQL-queryable today.
#   cloud-logging  severity-tagged structured stdout for Cloud Logging +
#                  Error Reporting (Swoop GCP, via Cloud Run / Ops Agent).
# EVENT_SINK=stdout
#
# Postgres URL for EVENT_SINK=postgres (and SESSION_BACKEND=postgres). Shares
# the connector's database (single store); set it explicitly — there is no
# implicit fallback to DATABASE_URL.
# ORCHESTRATOR_DATABASE_URL=postgresql://al:pick-a-password@localhost:5432/puma_dev

# ---------------------------------------------------------------------------
# Connector (B.t3 / B.t3a consumes — MCP-over-HTTP)
# ---------------------------------------------------------------------------

# MCP endpoint for the chunk C connector. Default points at the real
# @swoop/connector service on :3002 — flipped from :3001 (the in-tree stub)
# in B.t3a 2026-05-02 alongside the search/get_detail → eight-intent-named-
# tools surface rewrite. Run `npm run dev -w @swoop/connector` in a separate
# terminal before booting the orchestrator. Override here if pointing at a
# remote connector or a non-default port.
# CONNECTOR_URL=http://localhost:3002/mcp

# Per-call timeout for connector tool invocations, in ms. Too short → false
# negatives; too long → breaks conversational feel. Default: 10000.
# CONNECTOR_REQUEST_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# Server (B.t5 consumes CORS)
# ---------------------------------------------------------------------------

# HTTP port for the Express process. Default: 8080.
# PORT=8080

# NODE_ENV flips hot-reload on the prompt loader and dev-only behaviours.
# In any value other than "production", the prompt re-reads from disk on every
# request and verbose logging is enabled. Default: development.
# NODE_ENV=development

# Comma-separated list of origins allowed by CORS for the SSE /chat endpoint.
# Whitespace around commas is tolerated. Default: http://localhost:5173
# CORS_ALLOWED_ORIGINS=http://localhost:5173,https://staging.swoop.example

# ---------------------------------------------------------------------------
# Warm pool (reserved — B.t10 flips defaults when wired)
# ---------------------------------------------------------------------------

# Number of pre-warmed orchestrator instances. 0 = disabled. Default: 0.
# WARM_POOL_SIZE=0

# Idle TTL for a pooled instance in minutes. Default: 30.
# WARM_POOL_TTL_MINUTES=30

# ---------------------------------------------------------------------------
# Handoff mailer (E.t3 — verdict-aware email delivery)
# ---------------------------------------------------------------------------
#
# Off by default until Julie confirms the sales-inbox address + SMTP provider
# (tracked in questions.md). Flipping HANDOFF_EMAIL_ENABLED=true requires
# HANDOFF_EMAIL_FROM, HANDOFF_EMAIL_TO_QUALIFIED, SMTP_USER, SMTP_PASS — the
# config schema enforces this and fails fast at startup if any are missing.

# HANDOFF_EMAIL_ENABLED=false

# From-address on every handoff email. Required when ENABLED=true.
# HANDOFF_EMAIL_FROM=puma@swoop-adventures.com

# Where qualified-verdict leads land. Required when ENABLED=true.
# HANDOFF_EMAIL_TO_QUALIFIED=patagonia-leads@swoop-adventures.com

# Where referred-out-verdict leads land. Falls back to TO_QUALIFIED if blank.
# Common-case at launch: one inbox with subject-prefix differentiation.
# HANDOFF_EMAIL_TO_REFERRED_OUT=

# Directory holding handoff email templates (qualified.md / referred-out.md).
# Default: ../cms/templates/handoff
# HANDOFF_TEMPLATES_DIR=../cms/templates/handoff

# ---------------------------------------------------------------------------
# SMTP transport (consumed by the handoff mailer)
# ---------------------------------------------------------------------------
#
# Defaults to Gmail SMTP-over-TLS (PoC pattern). For production, swap to a
# transactional provider once Julie picks one (Postmark / SES / Mailgun).

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true

# SMTP credentials. Both required when HANDOFF_EMAIL_ENABLED=true.
# SMTP_USER=
# SMTP_PASS=

# ---------------------------------------------------------------------------
# Handoff retention sweeper (E.t6 — durable-record retention enforcement)
# ---------------------------------------------------------------------------
#
# Off by default. When enabled, the orchestrator runs sweepHandoffs() from
# @swoop/connector on a fixed cadence (default daily). Each sweep iterates
# the FsHandoffStore (interim) / PostgresHandoffStore (post-IAM), hard-deletes
# expired records per the authoritative retention windows from
# product/cms/legal/compliance-bundle/05-retention-policy.md, and emits
# handoff.retention.sweep.{started,completed,failed} events.
#
# The CLI external-trigger path (`npm run sweep:handoffs --workspace
# @swoop/connector`) is independent of these flags — it always runs one
# sweep regardless. That's the prod path (Cloud Scheduler → Cloud Run Job).
#
# Operator runbook: product/cms/ops/handoff-retention-sweep.md

# HANDOFF_RETENTION_SWEEP_ENABLED=false

# Cadence of the in-process sweep, in milliseconds. Default 24h.
# HANDOFF_RETENTION_SWEEP_INTERVAL_MS=86400000

# Delay after orchestrator boot before the first sweep, in milliseconds.
# Default 60s — keeps boot logs clean and avoids fighting other startup
# work for the first interval tick.
# HANDOFF_RETENTION_SWEEP_INITIAL_DELAY_MS=60000

# ---------------------------------------------------------------------------
# Postgres derived store (C.18 + C.21 + E.10 — single-store: retrieval,
# handoff, and the post-M4 custom session backend all share one Cloud SQL
# Postgres instance in prod; one local Postgres.app instance in dev)
# ---------------------------------------------------------------------------
#
# Local dev: Postgres.app v18 on :5432 with vector + pg_trgm extensions
# pre-installed in `puma_dev`. See gotchas.md for the bootstrap walkthrough.
# Prod: Cloud SQL for Postgres in the "AI Pat Chat" GCP project (post-M4).
#
# Currently unused — the orchestrator still reads the FsHandoffStore. The key
# is wired here ahead of the PostgresHandoffStore swap (E.t2 proper) and the
# custom Postgres SessionService (B.2 post-M4 upgrade).

# DATABASE_URL=postgresql://al:pick-a-password@localhost:5432/puma_dev
