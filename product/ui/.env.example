# Copy to `.env.local` and edit as needed. Vite loads .env.local automatically.
# Only VITE_-prefixed vars are bundled into the client. See vite.config.ts.

# Local orchestrator (chunk B) URL. Used by the AI SDK adapter to reach
# POST /session and POST /chat.
#
# Two modes:
#  - Direct (default): point straight at the local orchestrator. Works for
#    `npm run dev` on this machine.
#  - Proxied: set to `/api` to route through Vite's dev proxy (vite.config.ts).
#    Required when sharing the UI over Tailscale Funnel (see
#    `product/scripts/funnel.sh`) so the client browser and the API share a
#    single public origin.
VITE_ORCHESTRATOR_URL=http://localhost:8080
# VITE_ORCHESTRATOR_URL=/api   # uncomment when running scripts/funnel.sh up
