{
  "name": "@swoop/ingestion",
  "version": "0.1.0",
  "private": true,
  "description": "Ingestion utilities feeding the derived datasource (chunk C). Today: WordPress blog snapshot fetcher (planning/03-exec-blog-ingest.md). Future: SQL-dump derivation, image annotation pipeline.",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "blog:fetch": "tsx src/blog/fetch.ts",
    "blog:fetch:backfill": "tsx src/blog/fetch.ts --backfill",
    "blog:fetch:dry-run": "tsx src/blog/fetch.ts --dry-run",
    "etl:sql": "tsx src/sql-transform/index.ts",
    "annotate-images": "tsx src/images/annotate.ts",
    "enrich": "tsx src/enrich/index.ts",
    "enrich:embed": "tsx src/enrich/index.ts --mode=embed",
    "enrich:dry-run": "tsx src/enrich/index.ts --mode=all --dry-run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.90.0",
    "@google/genai": "^1.50.1",
    "@swoop/common": "*",
    "dotenv": "^17.4.2",
    "pg": "^8.13.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
