# macOS
.DS_Store

# JetBrains IDE
.idea/

# VS Code — allow shared extensions, ignore per-user settings
.vscode/settings.json
.vscode/launch.json
.vscode/tasks.json
# (allow .vscode/extensions.json)
!.vscode/extensions.json

# oh-my-claudecode
.omc/

# Symlink to sibling repo
chatgpt_poc

# Node / npm
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build artefacts
dist/
build/
.turbo/
.next/
.vercel/
*.tsbuildinfo

# Env files — never commit secrets; commit .env.example per package
.env
.env.local
.env.*.local

# Logs & coverage
logs/
*.log
coverage/
.nyc_output/

# Harness runs — per-run report folders (H.t1). `.gitkeep` preserved.
product/harness/runs/*
!product/harness/runs/.gitkeep

# graphify (safishamsi/graphify) output — visualization + queryable graph.
# Built locally with `graphify .` from product/. manifest.json is mtime-based
# and pollutes diffs; cost.json is local-only. Cache could be committed for
# team-wide rebuild speedup — leave excluded for now, revisit if rebuilds
# become a bottleneck.
product/graphify-out/
graphify-out/

# understand-anything (Egonex-AI/Understand-Anything) — code knowledge graph + dashboard.
# Built locally under product/.understand-anything/ via `/understand`, viewed with
# `/understand-dashboard`. Same posture as graphify-out above: large, derived and
# regenerable, so NOT committed. See product/handover/README.md for how to (re)generate,
# the recommended scan scope, and how to consult it.
product/.understand-anything/
.understand-anything/

# Local-only file-backed durable stores (E.t3 interim — FsHandoffStore writes
# handoff records here pending the Firestore swap targeted in E.t2). Never
# commit visitor PII / contact details to git.
product/orchestrator/var/
product/connector/var/

# OS / misc
Thumbs.db

.claude

# Local-only data dumps. Holds the Swoop SQL dump (received 2026-04-27) and
# the WordPress blog ingest snapshots (`data/blog/raw/<UTC-stamp>/`). Never
# commit — these contain content we don't have a redistribution licence for
# and may include PII-adjacent surfaces.
/data/
